{
  "name": "second-hand-marketplace",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "test": "npm run test -w server && npm run test -w client",
    "test:websocket": "node postman/websocket-smoke.mjs",
    "lint": "npm run lint -w server && npm run lint -w client",
    "format": "prettier --write \"**/*.{js,jsx,json,md,yml,yaml,css}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,json,md,yml,yaml,css}\"",
    "start": "npm run start -w server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.9.10"
  },
  "engines": {
    "node": ">=20"
  }
}
