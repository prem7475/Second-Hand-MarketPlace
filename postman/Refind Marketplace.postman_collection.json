{
  "info": {
    "_postman_id": "c2a65e21-78b0-4bde-98bc-dc529b534f41",
    "name": "Refind Marketplace",
    "description": "Run requests in order. Register makes a unique test user. Set otherListingId to a different user's listing before conversation requests. The Postman cookie jar retains the session and CSRF tokens are captured automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "csrfToken", "value": "" },
    { "key": "listingId", "value": "" },
    { "key": "otherListingId", "value": "" },
    { "key": "conversationId", "value": "" },
    { "key": "testEmail", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "API health",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/health" },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('API is healthy', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Get CSRF token",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/auth/csrf" },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('CSRF token is returned', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('csrfToken', pm.response.json().csrfToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-CSRF-Token", "value": "{{csrfToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Marketplace Tester\",\"email\":\"{{testEmail}}\",\"password\":\"sample-password-123\"}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('testEmail', 'tester+' + pm.variables.replaceIn('{{$guid}}') + '@example.com');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Registration succeeds', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('csrfToken', pm.response.json().csrfToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Sign in",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-CSRF-Token", "value": "{{csrfToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{testEmail}}\",\"password\":\"sample-password-123\"}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Sign in succeeded', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('csrfToken', pm.response.json().csrfToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Current user",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/auth/me" },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Session is authenticated', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Listings",
      "item": [
        {
          "name": "Browse listings",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/listings?page=1&limit=12&sort=newest"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Listing results include pagination', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().pagination).to.have.property('total'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Create listing",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-CSRF-Token", "value": "{{csrfToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"title\":\"Tester vintage lamp\",\"description\":\"A carefully kept lamp ready to brighten another home.\",\"price\":38,\"category\":\"Home & Living\",\"condition\":\"Good\",\"location\":\"Portland, OR\",\"images\":[]}"
            },
            "url": "{{baseUrl}}/api/listings"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Listing created', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.collectionVariables.set('listingId', pm.response.json().item._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get listing",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/listings/{{listingId}}" },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Listing is visible', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Update listing",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-CSRF-Token", "value": "{{csrfToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\"price\":35}" },
            "url": "{{baseUrl}}/api/listings/{{listingId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Listing updated', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Save listing",
          "request": {
            "method": "POST",
            "header": [{ "key": "X-CSRF-Token", "value": "{{csrfToken}}" }],
            "url": "{{baseUrl}}/api/favorites/{{listingId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Listing saved', () => pm.expect([200, 201]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "List favorites",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/favorites" },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Favorites loaded', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Remove favorite",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "X-CSRF-Token", "value": "{{csrfToken}}" }],
            "url": "{{baseUrl}}/api/favorites/{{listingId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Favorite removed', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Start conversation (other user's listing)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-CSRF-Token", "value": "{{csrfToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\"listingId\":\"{{otherListingId}}\"}" },
            "url": "{{baseUrl}}/api/conversations"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Conversation created', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('conversationId', pm.response.json().conversation._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List conversations",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/conversations" },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Conversations loaded', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Read conversation messages",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/conversations/{{conversationId}}/messages"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Message history loaded', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Send conversation message (REST fallback)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-CSRF-Token", "value": "{{csrfToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\"body\":\"Is this item still available?\"}" },
            "url": "{{baseUrl}}/api/conversations/{{conversationId}}/messages"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Message sent', () => pm.response.to.have.status(201));"]
              }
            }
          ]
        },
        {
          "name": "Delete listing",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "X-CSRF-Token", "value": "{{csrfToken}}" }],
            "url": "{{baseUrl}}/api/listings/{{listingId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Listing deleted', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Sign out",
          "request": {
            "method": "POST",
            "header": [{ "key": "X-CSRF-Token", "value": "{{csrfToken}}" }],
            "url": "{{baseUrl}}/api/auth/logout"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Signed out', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        }
      ]
    }
  ]
}
